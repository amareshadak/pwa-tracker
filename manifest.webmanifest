{
  "name": "Daily Tracker",
  "short_name": "Tracker",
  "description": "Personal habit + expense tracker",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f5ff",
